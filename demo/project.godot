config_version=5

[application]

config/name="Andrix Demo"
config/description="Projeto de demonstração do CI do Andrix Engine. Usado para gerar o .ipa assinado no GitHub Actions."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
